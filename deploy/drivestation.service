; drive-station systemd unit (template).
; @REPO@ and @PY@ are filled in by deploy/install.sh — run that, don't copy
; this file by hand.

[Unit]
Description=Drive Station wipe/test board
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
; Root is required: raw block device reads/writes, hdparm, dd.
User=root
WorkingDirectory=@REPO@
Environment=DRIVESTATION_MODE=real
ExecStart=@PY@ run.py
Restart=always
RestartSec=5
; Never rush a mid-wipe kill — SIGKILL on dd has taken down the whole USB
; hub tree. Prefer deploy/safe-restart.sh which refuses while WIPING.
TimeoutStopSec=180
KillMode=control-group
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target
